{
  "name": "crm-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-knowledge.mjs",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run data",
    "presearch:model": "npm run data",
    "presearch:index": "npm run data",
    "presearch:eval": "npm run data",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "search:model": "sh scripts/fetch-search-model.sh .cache/e5-source && python3 scripts/build-search-model.py .cache/e5-source public/models/e5-small-th --corpus data/crm.json data/knowledge.json data/search-phrases.json",
    "search:index": "node scripts/build-search-index.mjs public/models e5-small-th public/search/vectors.json",
    "search:eval": "tsx scripts/eval-search.mts public/search/eval.json"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.5.4",
    "@anthropic-ai/sdk": "^0.132.1",
    "@huggingface/transformers": "^4.3.1",
    "minisearch": "^7.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
