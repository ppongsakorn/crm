# --- AI provider: "anthropic" (Claude API, default) or "foundry" (Claude on Microsoft Foundry)
AI_PROVIDER=anthropic

# Claude API
ANTHROPIC_API_KEY=

# Microsoft Foundry (used when AI_PROVIDER=foundry)
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
# ANTHROPIC_FOUNDRY_API_KEY=

# Model + reasoning effort (low | medium | high | xhigh | max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Requests allowed per IP per 10 minutes
RATE_LIMIT_PER_10MIN=30
